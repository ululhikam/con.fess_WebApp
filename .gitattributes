# Normalise text files on commit…
* text=auto

# …and keep source files LF, matching .editorconfig + Prettier.
*.js     text eol=lf
*.vue    text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.cjs    text eol=lf
*.svg    text eol=lf

# Never touch binaries.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
