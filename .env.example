# ============================================================
# FessHub — Environment Configuration
# Copy to .env (gitignored) and adjust for your setup.
# ============================================================

# ---- API MODE ----
# Set to 'false' to use real backend. Default: true (mock).
VITE_USE_MOCK=true

# ---- REAL BACKEND ----
# Base URL for real API (used when VITE_USE_MOCK=false)
# VITE_API_BASE=https://api.fesshub.id/v1

# ---- APP ----
# App title shown in browser tab, meta tags, etc.
VITE_APP_TITLE=FessHub — Base Confess

# ---- FEATURE FLAGS ----
# Enable experimental features (analytics, new UI, etc.)
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=false

# ---- THIRD PARTY ----
# Google Analytics / Plausible / etc.
# VITE_GA_ID=G-XXXXXXXXXX

# ---- SOCIAL / SHARE ----
# Base URL for share links (used by generateShareData)
# VITE_SHARE_BASE_URL=https://fesshub.id