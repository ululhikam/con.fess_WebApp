# ==============================================================================
# Fess n Curious Frontend — Environment Variables (Vite)
# Salin menjadi .env dan sesuaikan. Di Vercel/Render, set lewat dashboard
# Environment Variables project.
# ==============================================================================

# Base URL request XHR (axios). Boleh relatif ("/api"):
#  - Dev  : diproxy otomatis oleh vite.config.js ke http://127.0.0.1:3000
#  - Produksi: gunakan URL absolut backend, mis. https://api.domainmu.com/api
VITE_API_BASE=/api

# URL ABSOLUT backend (tanpa trailing slash) — HANYA untuk redirect OAuth
# (Google & Instagram). Browser redirect tidak melewati proxy/Vite, jadi
# WAJIB menunjuk ke domain backend yang publik di produksi.
# Contoh produksi: https://be-fessncurious.vercel.app
VITE_BACKEND_URL=http://localhost:3000
