# ============================================================
# FessHub — Frontend Environment Configuration
# Copy ke .env lalu sesuaikan. File .env TIDAK di-commit ke git.
# ============================================================

# ---- BACKEND API (untuk fetch/XHR) ----
# Path relatif — Vite dev server mem-proxy /api → http://localhost:3000
# Di production (Vercel), set ke URL absolut backend:
# VITE_API_BASE=https://be-fnc.vercel.app/api
VITE_API_BASE=/api

# ---- BACKEND URL (KHUSUS untuk OAuth browser redirect) ----
# Harus ABSOLUT langsung ke backend — browser redirect tidak lewat Vite proxy.
# Dev:        http://localhost:3000
# Production: https://be-fnc.vercel.app
VITE_BACKEND_URL=http://localhost:3000

# ---- APP METADATA ----
VITE_APP_TITLE=Fess n Curious — Base Confess

# ---- FEATURE FLAGS ----
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_PWA=false

# ---- SOCIAL / SHARE ----
# Base URL untuk link share fess (WhatsApp, IG Story, dll)
# Dev:        http://localhost:5173
# Production: https://fessncurious.vercel.app
VITE_SHARE_BASE_URL=http://localhost:5173

# ---- THIRD PARTY (opsional) ----
# VITE_GA_ID=G-XXXXXXXXXX