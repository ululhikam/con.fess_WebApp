# ============================================================
# FessHub — Frontend Environment Configuration
# Copy ke .env lalu sesuaikan. File .env TIDAK di-commit ke git.
# ============================================================

# ---- BACKEND API ----
# URL base backend API yang digunakan oleh semua request fetch di app.
#
# DEV (localhost):       VITE_API_BASE=/api
#   → Vite dev-server mem-proxy /api ke http://127.0.0.1:3000 (lihat vite.config.js)
#   → Tidak butuh URL absolut karena proxy Vite menanganinya.
#
# PRODUCTION (deployed): VITE_API_BASE=https://be-fn-c.vercel.app/api
#   → Harus URL absolut ke backend yang sudah di-deploy di Vercel / hosting manapun.
#   → Isi sesuai URL backend Vercel-mu.
#
VITE_API_BASE=/api

# ---- APP METADATA ----
# Judul app yang muncul di tab browser, meta title, dan Open Graph.
VITE_APP_TITLE=Fess n Curious — Base Confess

# ---- FEATURE FLAGS ----
# VITE_ENABLE_ANALYTICS: aktifkan tracking/analytics (false = dinonaktifkan)
VITE_ENABLE_ANALYTICS=false
# VITE_ENABLE_PWA: aktifkan PWA / service worker
VITE_ENABLE_PWA=false

# ---- SOCIAL / SHARE ----
# Base URL untuk link share fess yang dibagikan ke luar (WhatsApp, IG Story, dll).
# DEV:        http://localhost:5173
# PRODUCTION: https://fessnc.vercel.app  ← ganti sesuai URL frontend-mu
VITE_SHARE_BASE_URL=http://localhost:5173

# ---- THIRD PARTY (opsional) ----
# Google Analytics — isi jika ingin tracking pengunjung
# VITE_GA_ID=G-XXXXXXXXXX